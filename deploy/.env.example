# Chép thành ~/trustsign/.env trên VPS rồi điền giá trị thật. KHÔNG commit file .env.

API_DOMAIN=api.example.com

POSTGRES_DB=trustsign_db
POSTGRES_USER=trustsign
POSTGRES_PASSWORD=<change_me>

Cors__AllowedOrigins__0=https://example.com
Media__PublicApiBaseUrl=https://api.example.com
# Bắt buộc đổi: giá trị mặc định trong appsettings.json là khóa dev công khai.
Media__TokenSecret=<chuoi_ngau_nhien_dai_32_ky_tu_tro_len>

Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__UseSsl=false
Smtp__Username=<change_me>
Smtp__Password=<change_me>
Smtp__FromEmail=noreply@example.com
Smtp__FrontendBaseUrl=https://example.com

Sepay__WebhookApiKey=<change_me>
Sepay__BankAccount=<change_me>
Sepay__BankName=MBBank
Sepay__BankCode=MB
Sepay__AccountName=HUYNH TAN LEN

AdminSeed__Email=<change_me>
AdminSeed__Password=<change_me>

# Sao chép thành .env khi cần đổi giá trị mặc định. File .env không được commit.

# docker-compose.yml (PostgreSQL trên máy phát triển)
POSTGRES_DB=trustsign_db
POSTGRES_USER=trustsign
POSTGRES_PASSWORD=trustsign_dev
POSTGRES_PORT=5433

# docker-compose.yml (MinIO trên máy phát triển)
MINIO_ROOT_USER=trustsign
MINIO_ROOT_PASSWORD=trustsign_dev

# Ghi đè cấu hình ứng dụng khi chạy ngoài Development (biến môi trường của tiến trình hoặc container)
# ConnectionStrings__TrustSignDb=Host=...;Port=5432;Database=trustsign_db;Username=...;Password=...
# Jwt__PrivateKeyPath=/run/secrets/jwt-signing-key.pem
# Jwt__Issuer=trustsign
# Jwt__Audience=trustsign-clients
# Cors__AllowedOrigins__0=https://trustsign.example.com
